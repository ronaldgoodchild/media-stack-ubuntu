# REGTeches Media Stack — environment config
# install.sh generates the real .env for you at $INSTALL_ROOT/.env from your
# flags/prompts. This file is a reference only — copy it if you ever want to
# hand-build a .env instead of running install.sh.

PUID=1000
PGID=1000
TZ=America/New_York
MEDIA_ROOT=/mnt/media

# Mullvad VPN (WireGuard) — required for qBittorrent's kill-switch (gluetun).
# Get these at https://mullvad.net/en/account/wireguard-config
#   Select: WireGuard, Linux, any server (e.g. us-nyc) -> download the .conf
#   -> PrivateKey and Address are inside it.
MULLVAD_PRIVATE_KEY=
MULLVAD_ADDRESS=
VPN_COUNTRY=USA

# Optional apps to bring up alongside the core stack (comma list, no spaces).
# Options: qbittorrent,sabnzbd,bazarr,lidarr,readarr,whisparr,seerr,recyclarr,arr-dashboard,npm
# (qbittorrent also controls whether gluetun/the VPN container starts)
COMPOSE_PROFILES=qbittorrent,sabnzbd,bazarr,lidarr,readarr,whisparr,seerr,recyclarr,arr-dashboard,npm

# ntfy.sh push alerts — install.sh generates a random topic unless you pass
# --ntfy-topic or --skip-ntfy. Treat the topic name like a password (see
# README's "Offline alerts" section) — leave blank to disable alerts.
NTFY_TOPIC=

# Jellyfin API key for the dashboard's "active streams" stat — NOT set by
# install.sh (Jellyfin's own first-run setup wizard has to be finished
# first). Once you've created your admin account, go to Jellyfin's Dashboard
# > API Keys > + , name it anything (e.g. "dashboard-stats"), and paste the
# key here. Leave blank and the Jellyfin card just won't show a live stat.
JELLYFIN_API_KEY=
